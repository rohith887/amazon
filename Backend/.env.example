# Server
PORT=4000
NODE_ENV=development

# CORS - comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# MongoDB connection string (local or Atlas)
DB_URI=mongodb://127.0.0.1:27017/grassroots_crm

# OTP email (nodemailer SMTP). OTPs are logged to console when not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Grassroots CRM <no-reply@grassrootsbpo.in>"
